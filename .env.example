# Copy to .env and fill in your values. Not auto-loaded by airflow-mcp-server itself -
# use it with `docker run --env-file .env ...` or `export $(grep -v '^#' .env | xargs)`.
# Every var here overrides its equivalent CLI flag when both are set.

# Required. Root Airflow URL - do NOT include /api/v2; the OpenAPI spec is fetched from
# ${AIRFLOW_BASE_URL}/openapi.json automatically.
AIRFLOW_BASE_URL=http://localhost:8080

# --- Credentials: pick ONE mode below. Leave all three unset (stdio/sse cannot do this -
#     see CONFIG.md) to run streamable-http in per-connection auth mode instead, where
#     each connecting client supplies its own Airflow JWT via an
#     `Authorization: Bearer <jwt>` header instead of the server sharing one identity. ---

# Mode 1: static JWT, shared by every connected client. Never refreshed - the server
# must be restarted once it expires.
# AUTH_TOKEN=

# Mode 2: username/password, shared by every connected client. The server logs in on
# startup and automatically refreshes its own JWT for the life of the process.
# AIRFLOW_USERNAME=
# AIRFLOW_PASSWORD=

# Optional. Directory of Markdown files to expose as read-only MCP resources.
# AIRFLOW_MCP_RESOURCES_DIR=

# --- Runtime options: equivalents of the CLI flags of the same name. ---

# stdio (default) | http | sse. Equivalent of --http/--sse.
# AIRFLOW_MCP_TRANSPORT=http

# Only used when AIRFLOW_MCP_TRANSPORT=http or sse. Equivalent of --port/--host.
# Use 0.0.0.0 for --host when running in Docker, so the published port is actually reachable.
# AIRFLOW_MCP_PORT=3000
# AIRFLOW_MCP_HOST=0.0.0.0

# safe (read-only tools) | unsafe (default, all tools). Equivalent of --safe/--unsafe.
# AIRFLOW_MCP_MODE=unsafe

# true/false. Equivalent of --static-tools (all tools listed immediately vs. hierarchical
# category browsing).
# AIRFLOW_MCP_STATIC_TOOLS=false
